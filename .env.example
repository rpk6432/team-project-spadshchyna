# Database (required)
POSTGRES_USER=spadshchyna_user
POSTGRES_PASSWORD=spadshchyna_pass
POSTGRES_DB=spadshchyna_db
DATABASE_URL=postgresql+asyncpg://spadshchyna_user:spadshchyna_pass@db:5432/spadshchyna_db

# JWT (required)
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=7

# Redis
REDIS_URL=redis://redis:6379/0

# Stripe (required)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Frontend
FRONTEND_URL=http://localhost:3000

# S3 / MinIO (keys required)
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=spadshchyna

# Email
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=noreply@spadshchyna.ua

# Pricing
SERVICE_FEE_PCT=3
